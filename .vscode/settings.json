{
    "sqlfluff.dialect": "tsql",
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "**/scripting/ps_modules/**": true
    },
    "workbench.colorCustomizations": {
        "editor.lineHighlightBorder": "#C792EA20",
        "editorCursor.foreground": "#C792EA",
        "tab.activeBorder": "#C792EA25",
        "tab.activeBorderTop": "#C792EA25",
        "tab.activeBackground": "#1D1629",
        "tab.activeForeground": "#D8A7FF",
        "statusBar.background": "#1D1629",
        "statusBar.foreground": "#C792EA",
        "editorIndentGuide.activeBackground1": "#C792EA28",
        "editor.selectionBackground": "#C792EA22",
        "editorBracketHighlight.foreground1": "#C792EA",
        "editorBracketHighlight.foreground2": "#D8A7FF"
    }
}
