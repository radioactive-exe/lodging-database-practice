{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Set up database",
            "detail": "Use build.ps1 to drop and recreate the Airbnb Database",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/build.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "env": {
                    "IN_DEV": "true"
                }
            },
            "presentation": {
                "reveal": "never",
                "revealProblems": "onProblem",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": {
                "owner": "powershell-sql",
                "fileLocation": "relative",
                "pattern": [
                    {
                        "regexp": "^Error in:\\s+(.*)\\.$",
                        "file": 1,
                        "kind": "file"
                    },
                    {
                        "regexp": "^Reason:\\s+(.*)$",
                        "message": 1,
                        "loop": true
                    }
                ]
            }
        }
    ]
}
